/ {


chosen {
zephyr,console = &uart0;
};


    my_custom_i2c: custom_i2c@3ff53000 {
        compatible = "binz,custom-i2c";
        reg = <0x3ff53000 0x1000>;

    #address-cells = <1>;

    #size-cells = <0>;



        status = "okay";
        clock-frequency = <400000>; // Fast mode
        
        sda-gpios = <&gpio0 21 GPIO_ACTIVE_HIGH>;
        scl-gpios = <&gpio0 22 GPIO_ACTIVE_HIGH>;
    };
};




&i2c0 {
    status = "disabled"; // Disable the default driver to use our custom one
};